#!/usr/bin/python3


r'''Split QUAKES flight data into smaller blocks

SYNOPSIS

  $ partition-quakes-data --input images-referenced.vnl \
                          --chunk-length-km  17         \
                          --chunk-overlap-km 5
  ...

DESCRIPTION

This tool takes in cross-referenced QUAKES metadata, and splits it into chunks,
as described in this email:

  From: "Donnellan, Andrea (US 3820)" <andrea.donnellan@jpl.nasa.gov>
  Subject: [quakes-i] Flight paths
  To: "quakes-i@list.jpl.nasa.gov" <quakes-i@list.jpl.nasa.gov>
  Date: Wed, 26 Oct 2022 19:12:21 -0700 (PDT) (1 week, 5 days, 19 hours ago)

  ...

  To initially create the blocks I suggest writing out 68 seconds worth of
  images (~17 km). Then back up 20 seconds (~5 km) and repeat the process. That
  way we get all of the images collected in manageable chunks of about 1088
  images and there is not a lot of software to write.

An analysis sequence that includes this step is described here:

  https://github.jpl.nasa.gov/kogan/uavsar/wiki/2022-10--QUAKES-flight-processing

'''


import sys
import argparse
import re
import os

def parse_args():

    parser = \
        argparse.ArgumentParser(description = __doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)

    parser.add_argument('--outdir',
                        type=str,
                        default = '.',
                        help='''Directory to write to. By default we use the
                        current directory''')

    parser.add_argument('--chunk-length-km',
                        type=float,
                        required=True,
                        help='''The length of each chunk we write, in km.
                        Required''')
    parser.add_argument('--chunk-overlap-km',
                        type=float,
                        required=True,
                        help='''The distance overlap between successive chunks,
                        in km. Required''')
    parser.add_argument('--input',
                        required=True,
                        type=str,
                        help='''An input vnlog of cross-referenced images
                        metadata. Required''')

    return parser.parse_args()

args = parse_args()

if args.chunk_length_km <= args.chunk_overlap_km:
    print("--chunk-length-km MUST be larger than --chunk-overlap-km",
          file=sys.stderr)
    sys.exit(1)

# arg-parsing is done before the imports so that --help works without building
# stuff, so that I can generate the manpages and README

import numpy as np
import numpysane as nps
import subprocess
import pyproj


def validate_headers(filename):
    try:
        with open(filename, 'rb') as f:
            fields_text = \
                subprocess.check_output(('vnl-filter','-l'),
                                        stdin = f,
                                        encoding = 'ascii')
            fields = fields_text.split()
            if fields != ['time',
                          'serialnumber',
                          'filename',
                          'latitude',
                          'longitude',
                          'altitude_ft',
                          'roll_deg',
                          'pitch_deg',
                          'heading_deg']:
                print(f"Input file '{filename}' doesn't have the expected columns. This program currently hard-codes the columns: their names, meaning and order",
                      file=sys.stderr)
                sys.exit(1)
    except:
        print(f"Couldn't read '{filename}' and parse it as a vnlog",
              file=sys.stderr)
        sys.exit(1)


def compute_cumulative_distance(time_sn_filename_lat_lon_alt_rpy):
    geod = pyproj.Geod(ellps = 'WGS84')

    lat = time_sn_filename_lat_lon_alt_rpy['lat_lon_alt_rpy'][:,0]
    lon = time_sn_filename_lat_lon_alt_rpy['lat_lon_alt_rpy'][:,1]
    N = len(lat)
    distance_successive = geod.inv(lon[:N-1],lat[:N-1],  lon[1:],lat[1:])[2]
    distance_cumulative = np.zeros( (N,), dtype=float)
    np.cumsum(distance_successive, out=distance_cumulative[1:])

    return distance_cumulative

def output_chunk(i0, i1,
                 time_sn_filename_lat_lon_alt_rpy,
                 distance_cumulative_m,
                 *,
                 start_description,
                 end_description):
    '''Writes out a chunk of data in rows [i0,i1] inclusive of the input'''

    if not hasattr(output_chunk, 'ichunk'):
        output_chunk.ichunk = 0

    length_m = distance_cumulative_m[i1] - distance_cumulative_m[i0]
    filename = f"{args.outdir}/chunk{output_chunk.ichunk:04d}-{(i1-i0+1):05d}images-{length_m/1000:06.02f}km.vnl"

    try:
        with open(filename, 'w') as f:

            # I don't think numpy can write out compound arrays, so I do it
            # myself. Probably this is SLOW
            print("# time serialnumber filename latitude longitude altitude_ft roll_deg pitch_deg heading_deg",
                  file=f)

            images_t               = time_sn_filename_lat_lon_alt_rpy['time']
            images_serialnumber    = time_sn_filename_lat_lon_alt_rpy['serialnumber']
            images_filename        = time_sn_filename_lat_lon_alt_rpy['filename']
            images_lat_lon_alt_rpy = time_sn_filename_lat_lon_alt_rpy['lat_lon_alt_rpy']

            for i in range(i0,i1+1):
                print(f"{images_t[i]} {images_serialnumber[i]} {images_filename[i].decode()} {' '.join(str(x) for x in images_lat_lon_alt_rpy[i])}",
                      file=f)

    except Exception as e:
        print(f"Couldn't write output to '{filename}': {e}",
              file=sys.stderr)
        sys.exit(1)

    output_chunk.ichunk += 1

    print(f"Wrote '{filename}'; from {start_description} to {end_description}")


def backup_to_overlap(i0, distance, distance_cumulative_m):
    r'''Finds an earlier to that's at least the given distance away'''

    return \
        np.searchsorted(distance_cumulative_m[:i0],
                        distance_cumulative_m[i0]-distance)



validate_headers(args.input)

try:
    with open(args.input, 'rb') as f:
        time_sn_filename_lat_lon_alt_rpy = \
            np.loadtxt(f,
                       dtype=[('time',            float),
                              ('serialnumber',    np.uint32),
                              ('filename',        '|S128'),
                              ('lat_lon_alt_rpy', '6float')])
except:
    print(f"Couldn't read '{args.input}' as a vnlog",
          file=sys.stderr)
    sys.exit(1)


distance_cumulative_m = \
    compute_cumulative_distance(time_sn_filename_lat_lon_alt_rpy)


# Done with the prep. Let's do the thing!

# This is slow to do as a Python loop, but it's a one-time cost, so it's
# fast-enough

# I don't create chunks that have gaps between images of this size of more
threshold_distance_m = 1000
threshold_time_s     = 20

t = time_sn_filename_lat_lon_alt_rpy['time']

def distance_between_m(i0, i1):
    return distance_cumulative_m[i1] - distance_cumulative_m[i0]
def time_between_s(i0, i1):
    return t[i1] - t[i0]

Nrows = len(time_sn_filename_lat_lon_alt_rpy)

i_chunk_start = 0
start_description = "the start of the log"
for i_here in range(1,Nrows):
    if distance_between_m(i_here-1, i_here) > threshold_distance_m or \
       time_between_s    (i_here-1, i_here) > threshold_time_s:
        # We have a data discontinuity. This chunk ends at the previous row. And
        # the next chunk starts at THIS row, with no overlap
        output_chunk(i_chunk_start, i_here-1,
                     time_sn_filename_lat_lon_alt_rpy,
                     distance_cumulative_m,
                     start_description = start_description,
                     end_description   = "a data dropout")
        i_chunk_start     = i_here
        start_description = "a data dropout"
    elif distance_between_m(i_chunk_start, i_here) > args.chunk_length_km*1000:
        output_chunk(i_chunk_start, i_here-1,
                     time_sn_filename_lat_lon_alt_rpy,
                     distance_cumulative_m,
                     start_description = start_description,
                     end_description   = "a distance boundary")
        i_chunk_start = backup_to_overlap(i_here, args.chunk_overlap_km*1000,
                                          distance_cumulative_m)
        start_description = "a distance boundary"
    elif i_here == Nrows-1:
        output_chunk(i_chunk_start, i_here-1,
                     time_sn_filename_lat_lon_alt_rpy,
                     distance_cumulative_m,
                     start_description = start_description,
                     end_description   = "the end of the log")
