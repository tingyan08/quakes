#!/usr/bin/python3


r'''Split QUAKES flight data into smaller blocks

SYNOPSIS

  $ < images-referenced.vnl \
      partition-quakes-data --outdir . \
                            --chunk-length-km  17 \
                            --chunk-overlap-km 5
  ...

DESCRIPTION

This tool takes in cross-referenced QUAKES metadata, and splits it into chunks,
as described in this email:

  From: "Donnellan, Andrea (US 3820)" <andrea.donnellan@jpl.nasa.gov>
  Subject: [quakes-i] Flight paths
  To: "quakes-i@list.jpl.nasa.gov" <quakes-i@list.jpl.nasa.gov>
  Date: Wed, 26 Oct 2022 19:12:21 -0700 (PDT) (1 week, 5 days, 19 hours ago)

  ...

  To initially create the blocks I suggest writing out 68 seconds worth of
  images (~17 km). Then back up 20 seconds (~5 km) and repeat the process. That
  way we get all of the images collected in manageable chunks of about 1088
  images and there is not a lot of software to write.

An analysis sequence that includes this step is described here:

  https://github.jpl.nasa.gov/kogan/uavsar/wiki/2022-10--QUAKES-flight-processing

'''


import sys
import argparse
import re
import os

def parse_args():

    parser = \
        argparse.ArgumentParser(description = __doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)

    parser.add_argument('--outdir',
                        type=str,
                        default = '.',
                        help='''Directory to write to. By default we use the
                        current directory''')

    parser.add_argument('--chunk-length-km',
                        type=float,
                        required=True,
                        help='''The length of each chunk we write, in km.
                        Required''')
    parser.add_argument('--chunk-overlap-km',
                        type=float,
                        required=True,
                        help='''The distance overlap between successive chunks,
                        in km. Required''')

    return parser.parse_args()

args = parse_args()

if sys.stdin.isatty():
    print("Input should be passed on STDIN",
          file=sys.stderr)
    sys.exit(1)

